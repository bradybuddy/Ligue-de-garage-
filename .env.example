# Buddy & Beer — variables d'environnement. Copier en .env.local et remplir.
# Aucune valeur ici : chaque clé vient de TON compte (Supabase, Twilio, Resend…). Ne jamais commiter .env.local.
# En local : node scripts/local-keys.mjs > .env.local  (pile supabase/local)

# ── Appli ──
APP_URL=                               # ex. https://buddyandbeer.ca (sans / final) ; sert aux liens des courriels et textos
CRON_SECRET=                           # long et aléatoire : openssl rand -hex 32 ; pg_cron l'envoie en Bearer
UNSUBSCRIBE_SECRET=                    # long et aléatoire : signe les liens de désabonnement

# ── Supabase (Project Settings → API / Database) ──
NEXT_PUBLIC_SUPABASE_URL=              # https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # clé publique (anon / publishable)
SUPABASE_SERVICE_ROLE_KEY=             # SECRÈTE : serveur seulement (suppression de compte, seed)
DATABASE_URL=                          # pooler en mode transaction (port 6543), région ca-central-1
DATABASE_URL_DIRECT=                   # connexion directe (port 5432) pour les migrations
DATABASE_POOL_MAX=                     # optionnel, défaut 5

# ── Twilio (textos) — numéro canadien ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                     # SECRÈTE : signe aussi les webhooks entrants
TWILIO_MESSAGING_SERVICE_SID=          # recommandé (sinon TWILIO_FROM)
TWILIO_FROM=                           # ex. +15145551234
TWILIO_WEBHOOK_URL=                    # URL exacte configurée chez Twilio : ${APP_URL}/api/webhooks/twilio/sms

# ── Courriel (Resend, domaine vérifié SPF/DKIM/DMARC) ──
RESEND_API_KEY=
EMAIL_FROM=                            # ex. Buddy & Beer <rappels@mail.buddyandbeer.ca>
MAILPIT_URL=                           # dev seulement : http://localhost:54324

# ── Notifs Web Push (npx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                     # SECRÈTE
VAPID_SUBJECT=                         # mailto:toi@tondomaine.ca

# ── GIF dans le chat (developers.giphy.com, clé de production) ──
GIPHY_API_KEY=                         # vide = bouton GIF désactivé

# ── Développement seulement ──
ALLOW_DEMO=                            # 1 = autorise /dev et le webhook texto sans signature avec NODE_ENV=production. JAMAIS en ligne.
TEST_DATABASE_URL=                     # npm run test:db (EFFACE les données de cette base)

# ── Surveillance des erreurs (Sentry, région US ou EU) ──
SENTRY_DSN=                            # serveur ; vide = désactivé
NEXT_PUBLIC_SENTRY_DSN=                # navigateur (même valeur)

# ── Santé (page /etat et vérification de disponibilité) ──
# Rien à configurer : /api/sante répond 200 si la base répond et que le cron a roulé dans les 10 dernières minutes.
