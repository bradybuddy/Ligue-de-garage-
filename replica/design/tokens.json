    "dark": {
      "bg": "#0D1117",
      "surface": "#161C24",
      "surface-2": "#202833",
      "border": "#2D3744",
      "border-input": "#6E7A8B",
      "text": "#E9EDF2",
      "text-muted": "#9DA8B7",
      "accent": "#F4AE2A",
      "on-accent": "#1C1300",
      "accent-strong": "#FFC85C",
      "accent-soft": "#382909",
      "on-accent-soft": "#FFD98A",
      "ring": "#6AA6F5",
      "in": "#35BE6E",
      "on-in": "#04140A",
      "in-soft": "#11301F",
      "on-in-soft": "#8BEBB0",
      "out": "#F2625F",
      "on-out": "#1E0505",
      "out-soft": "#3A1618",
      "on-out-soft": "#FFAAA8",
      "wait": "#A88BFA",
      "on-wait": "#140A30",
      "wait-soft": "#271C48",
